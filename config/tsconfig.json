{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2016",
    "lib": ["DOM", "ES2022"],

    /* Modules */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["*"],
    "resolveJsonModule": true,

    /* Emit */
    "declaration": true,
    "sourceMap": true,
    "newLine": "lf",
    "stripInternal": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,

    /* Completeness */
    "skipLibCheck": true
  }
}
